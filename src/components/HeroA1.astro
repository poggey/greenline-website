---
// ALT1 — Cinematic full-bleed: a sunlit site photo, Bitumen gradient scrim,
// bold off-white statement bottom-left, and a floating frosted "spec chip".
import { Image } from 'astro:assets';
import bg from '../assets/images/construction-flagship.jpg';
---

<section class="a1" id="top" data-hero>
  <Image class="a1__bg" src={bg} alt="" widths={[1000, 1600, 2200]} sizes="100vw" loading="eager" />
  <div class="a1__scrim" aria-hidden="true"></div>

  <div class="wrap a1__content">
    <p class="a1__eyebrow" data-reveal="up">Health, Safety &amp; Environmental</p>
    <h1 class="a1__headline" data-reveal="up">Practical safety that works on the ground</h1>
    <p class="a1__lede" data-reveal="up">
      Senior HSE expertise for Australian construction, infrastructure and rural operations —
      delivered direct.
    </p>
    <a class="btn a1__cta" href="#contact" data-magnetic data-reveal="up"
      >Start a conversation <span class="btn__arrow" aria-hidden="true">→</span></a
    >
  </div>

  <aside class="a1__chip" data-reveal="up">
    <span class="a1__chip-k">On every site</span>
    <span class="a1__chip-v">Falls from height · Plant &amp; traffic · Compliance, managed.</span>
  </aside>
</section>

<style>
  .a1 {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--paper-on-dark);
  }
  .a1__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .a1__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(24, 39, 29, 0.2) 0%,
      rgba(24, 39, 29, 0) 32%,
      rgba(24, 39, 29, 0.5) 72%,
      rgba(24, 39, 29, 0.82) 100%
    );
  }
  .a1__content {
    position: relative;
    padding-block: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 42rem;
  }
  .a1__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hi-vis);
    margin: 0;
  }
  .a1__headline {
    font-family: var(--font-display);
    font-size: var(--step-hero);
    line-height: 1.05;
    color: var(--paper-on-dark);
    max-width: 15ch;
    margin: 0.25rem 0 0.4rem;
  }
  .a1__lede {
    max-width: 42ch;
    color: rgba(243, 241, 228, 0.88);
  }
  .a1__cta {
    margin-top: var(--space-s);
    align-self: flex-start;
    --btn-bg: var(--hi-vis);
    --btn-fg: var(--bitumen);
    font-weight: 700;
  }
  .a1__cta:hover {
    background: var(--paper-on-dark);
    border-color: var(--paper-on-dark);
    color: var(--bitumen);
  }
  .a1__chip {
    position: absolute;
    top: 7rem;
    right: var(--gutter);
    max-width: 18rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.3rem;
    background: rgba(247, 244, 234, 0.12);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    border: 1px solid rgba(243, 241, 228, 0.32);
    border-radius: var(--radius);
  }
  .a1__chip-k {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hi-vis);
  }
  .a1__chip-v {
    font-family: var(--font-display);
    font-size: var(--step-0);
    line-height: 1.3;
    color: var(--paper-on-dark);
  }
  @media (max-width: 760px) {
    .a1__chip {
      display: none;
    }
  }
</style>
