---
// EXPERIMENT — exact replica of the home page on a different colour scheme
// ("Harbour": navy + marigold). Same components; only the palette differs,
// driven by <Base theme="alt"> → <html data-theme="alt">. The original site
// at "/" is untouched. This route is noindexed.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ThroughLine from '../components/ThroughLine.astro';
import Hero from '../components/Hero.astro';
import SafetyReality from '../components/SafetyReality.astro';
import MeetGreenline from '../components/MeetGreenline.astro';
import Services from '../components/Services.astro';
import AreasOfWork from '../components/AreasOfWork.astro';
import BusinessCase from '../components/BusinessCase.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base theme="alt" title="Greenline HSE — Harbour theme (experiment)">
  <Header />
  <ThroughLine />
  <main id="main">
    <Hero />
    <MeetGreenline />
    <SafetyReality />
    <Services />
    <AreasOfWork />
    <BusinessCase />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/motion.js';
</script>
