---
// 1. HERO (§12.1) — full-bleed sector photograph showing the HSE advisor with
// a construction worker and a farmer, so both sectors read instantly. A
// CSS scrim (anchored to the container's left edge, not baked into the photo)
// carries the text, so legibility holds at every crop and still works if the
// image is later swapped for a version without the baked-in green gradient.
// The headline keeps its kinetic word-swap (safety / risk / compliance / culture).
import { Image } from 'astro:assets';
import heroImage from '../assets/images/greenline-hse-sector-hero-v2.png';
---

<section class="hero" id="top" data-hero>
  <Image
    class="hero__img"
    src={heroImage}
    alt="A Greenline HSE advisor reviewing a tablet on site with a construction worker and a farmer, an active construction site behind them on one side and a working farm on the other"
    widths={[768, 1280, 1836]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="wrap hero__content">
    <p class="hero__eyebrow">Greenline HSE</p>
    <h1 class="hero__headline">
      Practical
      <span class="hero__swap-wrap"
        ><span
          class="hero__swap"
          data-word-swap
          data-words='["safety","risk","compliance","culture"]'
          >safety</span
        ></span
      ><br />that works on the ground.
    </h1>
    <p class="hero__lede">
      Senior Health, Safety and Environmental expertise across construction, infrastructure and
      agriculture — delivered direct.
    </p>
    <a class="btn hero__cta" href="#contact" data-magnetic
      >Start a conversation <span class="btn__arrow" aria-hidden="true">→</span></a
    >
  </div>

  <a class="hero__scroll" href="#meet" aria-label="Scroll to meet Greenline">
    <span class="hero__scroll-label">Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 6rem;
    padding-bottom: 6rem;
    isolation: isolate;
  }
  /* full-bleed photograph */
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
  }
  /* legibility scrim — strongest at the left where the text sits, fading to
     reveal the photograph on the right. Anchored to the container, so it does
     not depend on any gradient being baked into the image. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      95deg,
      rgba(24, 39, 29, 0.86) 0%,
      rgba(24, 39, 29, 0.64) 26%,
      rgba(24, 39, 29, 0.3) 47%,
      rgba(24, 39, 29, 0) 66%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hi-vis);
    margin: 0;
  }
  .hero__headline {
    font-family: var(--font-display);
    font-weight: 380;
    /* Smaller than the old photo-less hero so the words sit within the dark
       scrim on the left and don't sprawl across the people in the photo. */
    font-size: clamp(2.1rem, 1.3rem + 2.4vw, 3.75rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: var(--paper-on-dark);
    max-width: 15ch;
    margin: 0;
    text-shadow: 0 1px 24px rgba(24, 39, 29, 0.35);
  }
  /* cycling word — fade-swaps in place; no clip, so nothing is cut off */
  .hero__swap-wrap {
    display: inline-block;
  }
  .hero__swap {
    display: inline-block;
    font-style: italic;
    color: var(--paper-on-dark);
    border-bottom: 0.08em solid var(--hi-vis);
    padding: 0 0.04em 0.04em;
  }
  .hero__lede {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--paper-on-dark);
    text-shadow: 0 1px 18px rgba(24, 39, 29, 0.4);
  }
  /* key CTA picked out in Hi-Vis so it pops off the photograph */
  .hero__cta {
    align-self: flex-start;
    --btn-bg: var(--hi-vis);
    --btn-fg: var(--bitumen);
    font-weight: 700;
  }
  .hero__cta:hover {
    background: var(--paper-on-dark);
    border-color: var(--paper-on-dark);
    color: var(--bitumen);
  }

  .hero__scroll {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.5rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper-on-dark-dim);
  }
  /* text-indent offsets the trailing letter-spacing so the label's glyphs
     centre on the same axis as the line below */
  .hero__scroll-label {
    display: inline-block;
    text-indent: 0.2em;
  }
  .hero__scroll-line {
    width: 1px;
    height: 38px;
    background: linear-gradient(var(--paper-on-dark-dim), transparent);
  }

  /* On narrow screens the photo crops to a busy centre, so the scrim becomes a
     fuller vertical wash to keep the text crisp. */
  @media (max-width: 600px) {
    .hero__scrim {
      background: linear-gradient(
        180deg,
        rgba(24, 39, 29, 0.55) 0%,
        rgba(24, 39, 29, 0.7) 100%
      );
    }
    .hero__scroll {
      display: none;
    }
  }
</style>
