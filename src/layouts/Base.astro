---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Greenline HSE — Practical Health, Safety & Environmental Expertise',
  description = 'Practical Health, Safety & Environmental expertise for Australian construction, infrastructure and rural operations. Senior advice, delivered direct.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

// schema.org structured data (§14) — ProfessionalService for the firm,
// Person for Catriona with her credentials.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${Astro.site}#organisation`,
      name: 'Greenline HSE',
      description,
      slogan: 'Practical Solutions. Strong Relationships. Better Outcomes.',
      url: canonical,
      areaServed: {
        '@type': 'Country',
        name: 'Australia',
      },
      serviceType: [
        'Health & Safety Management Systems',
        'Risk Assessments',
        'Standard Operating Procedures',
        'Site Audits & Inspections',
        'Contractor Management',
        'Incident Investigations',
        'Compliance Reviews',
        'Training & Inductions',
        'Emergency Planning',
        'Leadership & Safety Culture',
      ],
      knowsAbout: [
        'Construction safety',
        'Infrastructure safety',
        'Work Health and Safety',
        'Agricultural safety',
        'WHS compliance',
      ],
      founder: { '@id': `${Astro.site}#catriona` },
    },
    {
      '@type': 'Person',
      '@id': `${Astro.site}#catriona`,
      name: 'Catriona Monaghan',
      jobTitle: 'Principal HSE Consultant & Founder',
      worksFor: { '@id': `${Astro.site}#organisation` },
      description:
        'Founder of Greenline HSE with more than twenty years of cross-sector Health, Safety & Environmental experience across Ireland and Australia.',
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'degree',
          name: 'BSc (Hons) Health & Safety Systems',
        },
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'certificate',
          name: 'Cert IV Environmental Management & Sustainability',
        },
      ],
      knowsAbout: ['Construction', 'Infrastructure', 'Health', 'Industrial', 'Rural & Agriculture'],
    },
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Twitter cards (§14) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Greenline HSE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#2D5A3D" />

    <!-- Fonts (§10): Fraunces (display) + Hanken Grotesk (body & labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Hanken+Grotesk:wght@300..700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <button class="to-top" data-to-top type="button" aria-label="Back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>
  </body>
</html>
