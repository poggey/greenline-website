---
// ALTERNATE HERO (experiment) — editorial gallery. A centered statement with a
// Hi-Vis highlighted phrase and a pill CTA, over a staggered strip of the
// brand's real photography rising along the bottom. Light, premium, ownable.
import { Image } from 'astro:assets';
import imgFarm from '../assets/images/meet-mayo-farmland.jpg';
import imgPaddock from '../assets/images/agriculture-paddock.jpg';
import imgCrane from '../assets/images/construction-flagship.jpg';
import imgWorker from '../assets/images/safety-reality.jpg';
import imgStill from '../assets/images/meet-stilllife.jpg';

// staggered heights — a gentle arc, tallest in the middle (the flagship)
const cards = [
  { src: imgFarm, alt: 'Sunlit west-of-Ireland farmland under an open sky', h: 64 },
  { src: imgPaddock, alt: 'An Australian farm paddock in golden-hour light', h: 84 },
  { src: imgCrane, alt: 'A tower crane and steel frame against a clear blue sky', h: 100 },
  { src: imgWorker, alt: 'A hi-vis worker on a sunlit early-morning construction site', h: 84 },
  { src: imgStill, alt: 'A hard hat resting on rolled site drawings in clean daylight', h: 64 },
];
---

<section class="herod" id="top" data-hero>
  <div class="herod__top">
    <p class="herod__eyebrow" data-reveal="up">Health, Safety &amp; Environmental</p>
    <h1 class="herod__headline" data-reveal="up">
      Practical safety that <em class="herod__em">works on the ground</em>
    </h1>
    <a class="herod__cta" href="#contact" data-magnetic data-reveal="up">
      Start a conversation <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="herod__gallery" data-hero-gallery>
    {
      cards.map((c) => (
        <figure class="herod__card" style={`--h:${c.h}%`} data-card>
          <Image src={c.src} alt={c.alt} widths={[260, 520]} sizes="(max-width: 760px) 38vw, 260px" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .herod {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--limewash);
    padding-top: 5.5rem;
    overflow: hidden;
  }

  .herod__top {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-m);
    padding: var(--space-l) var(--gutter);
  }
  .herod__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--field-green);
    margin: 0;
  }
  .herod__headline {
    font-family: var(--font-display);
    font-weight: 380;
    font-size: clamp(2.5rem, 1.1rem + 5.4vw, 5.75rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    color: var(--field-green);
    max-width: 16ch;
    margin: 0;
  }
  .herod__em {
    font-style: italic;
    color: var(--field-green);
    background: var(--hi-vis);
    padding: 0.02em 0.22em;
    border-radius: 4px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  /* pill CTA */
  .herod__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: var(--space-s);
    padding: 0.95em 1.9em;
    background: var(--cloud);
    color: var(--field-green);
    border: 1px solid var(--sage);
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 8px 28px rgba(24, 39, 29, 0.1);
    transition: background 0.3s var(--ease-out), color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
    will-change: transform;
  }
  .herod__cta:hover {
    background: var(--field-green);
    color: var(--paper-on-dark);
    border-color: var(--field-green);
  }

  /* staggered gallery strip rising along the bottom */
  .herod__gallery {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(0.5rem, 1.1vw, 1rem);
    height: clamp(160px, 28vh, 320px);
    padding: 0 var(--gutter);
  }
  .herod__card {
    flex: 1 1 0;
    max-width: 230px;
    height: var(--h);
    margin: 0;
    border-radius: 14px 14px 0 0;
    overflow: hidden;
    background: var(--sage-mist);
  }
  .herod__card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 760px) {
    .herod__gallery {
      height: clamp(130px, 22vh, 200px);
      gap: 0.4rem;
    }
    /* keep three cards on small screens, hide the outer two */
    .herod__card:first-child,
    .herod__card:last-child {
      display: none;
    }
  }
</style>
