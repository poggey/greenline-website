---
// 6. TWO SECTORS (§12.6) — Construction & Infrastructure and Agriculture &
// Rural, presented as two balanced, parallel cards: the firm works equally
// across both. One cohesive palette.
import { Image } from 'astro:assets';
import constructionFlagship from '../assets/images/construction-flagship.jpg';
import agriculturePaddock from '../assets/images/agriculture-paddock.jpg';

const sectorCards = [
  {
    id: 'construction',
    img: constructionFlagship,
    alt: 'A tower crane and steel frame against a clear blue sky',
    eyebrow: 'On site',
    title: 'Construction & Infrastructure',
    body: 'Support through every phase of delivery — from planning and enabling works to handover — managing the risks that matter most: falls from height, and plant and traffic.',
    covers: 'Healthcare · Rail & transport · Commercial · Residential · Industrial · Demolition · Civil · Aviation',
  },
  {
    id: 'agriculture',
    img: agriculturePaddock,
    alt: 'An Australian farm paddock in golden-hour light',
    eyebrow: 'On the land',
    title: 'Agriculture & Rural',
    body: 'HSE that fits how rural work runs — machinery, chemicals, emergency planning, SOPs and risk assessments. Agriculture carries the highest fatality rate of any Australian industry, so the support has to be real.',
    covers: 'Livestock · Cropping · Mixed farming · Agricultural contractors',
  },
];
---

<section class="section" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <p class="section-index">Where we work</p>
    <h2 id="areas-h" class="areas-title" data-split>Two sectors, one practical approach</h2>
    <p class="lede" data-reveal="up">
      Greenline HSE works across two sectors — construction &amp; infrastructure, and agriculture
      &amp; rural. Each gets the same senior, fit-for-purpose support, tailored to how the work is
      actually done.
    </p>

    <div class="areas-grid">
      {
        sectorCards.map((s) => (
          <article class="sector" id={s.id} data-reveal="up">
            <figure class="sector__media">
              <Image
                src={s.img}
                alt={s.alt}
                class="sector__img"
                widths={[480, 800]}
                sizes="(max-width: 760px) 100vw, 50vw"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="sector__panel">
                <span class="sector__eyebrow">{s.eyebrow}</span>
                <h3 class="sector__title">{s.title}</h3>
              </figcaption>
            </figure>
            <p class="sector__body">{s.body}</p>
            <p class="sector__covers"><span class="sector__covers-k">Covers</span> {s.covers}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .areas-title {
    font-size: var(--step-3);
    max-width: 20ch;
    margin-bottom: var(--space-m);
  }

  .areas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
  .sector {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    scroll-margin-top: 6rem;
  }
  .sector__media {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .sector__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  /* matching frosted-glass label on each image */
  .sector__panel {
    position: absolute;
    left: clamp(1rem, 2.5vw, 1.5rem);
    right: clamp(1rem, 2.5vw, 1.5rem);
    bottom: clamp(1rem, 2.5vw, 1.5rem);
    padding: clamp(0.9rem, 1.5vw, 1.25rem) clamp(1.1rem, 2vw, 1.5rem);
    background: rgba(247, 244, 234, 0.6);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    border: 1px solid rgba(252, 250, 243, 0.55);
    border-radius: var(--radius);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sector__panel {
      background: rgba(247, 244, 234, 0.95);
    }
  }
  .sector__eyebrow {
    display: block;
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--field-green);
  }
  .sector__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--field-green);
    margin: 0;
  }
  .sector__body {
    color: var(--bitumen);
    max-width: 46ch;
  }
  .sector__covers {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--bitumen);
  }
  .sector__covers-k {
    color: var(--sage);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-right: 0.5rem;
  }

  @media (max-width: 760px) {
    .areas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
