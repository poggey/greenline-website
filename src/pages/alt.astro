---
// EXPERIMENT — same green palette as the live site, but trying a different
// hero design (split editorial layout). Everything below the hero is identical
// to `/`. This route is noindexed so it won't affect SEO.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ThroughLine from '../components/ThroughLine.astro';
import HeroSplit from '../components/HeroSplit.astro';
import SafetyReality from '../components/SafetyReality.astro';
import MeetGreenline from '../components/MeetGreenline.astro';
import Services from '../components/Services.astro';
import AreasOfWork from '../components/AreasOfWork.astro';
import BusinessCase from '../components/BusinessCase.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base noindex title="Greenline HSE — hero concept (experiment)">
  <Header />
  <ThroughLine />
  <main id="main">
    <HeroSplit />
    <MeetGreenline />
    <SafetyReality />
    <Services />
    <AreasOfWork />
    <BusinessCase />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/motion.js';
</script>
