---
// ALTERNATE HERO (experiment) — a confident full-screen Field-Green statement.
// No decorative gimmicks: type-led, built from the site's own design system
// (Hi-Vis kicker dash, the type scale, a spec-sheet meta row), so it reads as
// one cohesive, deliberate composition. Same green palette.
const meta = ['20+ years · Ireland & Australia', 'Australia-wide', 'Senior advice, delivered direct'];
---

<section class="heroc" id="top" data-hero>
  <div class="wrap heroc__inner">
    <p class="heroc__kicker" data-reveal="up">
      <span class="heroc__dash" aria-hidden="true"></span>Health, Safety &amp; Environmental
    </p>
    <h1 class="heroc__headline" data-split>Practical safety that works on the ground</h1>
    <p class="heroc__lede" data-reveal="up">
      Senior HSE expertise for Australian construction, infrastructure and rural operations —
      delivered direct by the person you actually talk to.
    </p>
    <div class="heroc__actions" data-reveal="up">
      <a class="btn heroc__cta" href="#contact" data-magnetic
        >Start a conversation <span class="btn__arrow" aria-hidden="true">→</span></a
      >
    </div>
    <ul class="heroc__meta" data-reveal="up">
      {meta.map((m) => <li>{m}</li>)}
    </ul>
  </div>

  <a class="heroc__scroll" href="#meet" aria-label="Scroll to meet Greenline">
    <span>Scroll</span>
    <span class="heroc__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .heroc {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: var(--field-green);
    color: var(--paper-on-dark);
    padding: 7rem 0 var(--space-xl);
    overflow: hidden;
  }
  .heroc__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
  }

  /* same kicker treatment as the rest of the site, on dark */
  .heroc__kicker {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--paper-on-dark);
    margin: 0;
  }
  .heroc__dash {
    width: clamp(2rem, 6vw, 4rem);
    height: 1px;
    background: var(--hi-vis);
  }

  .heroc__headline {
    font-size: var(--step-hero);
    line-height: 1.04;
    color: var(--paper-on-dark);
    max-width: 16ch;
    margin: 0.25rem 0 0.5rem;
  }
  .heroc__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 44ch;
    color: var(--paper-on-dark-dim);
  }
  .heroc__actions {
    margin-top: var(--space-s);
  }
  /* Hi-Vis CTA on the green field */
  .heroc__cta {
    --btn-bg: var(--hi-vis);
    --btn-fg: var(--bitumen);
    font-weight: 700;
  }
  .heroc__cta:hover {
    background: var(--paper-on-dark);
    border-color: var(--paper-on-dark);
    color: var(--bitumen);
  }

  /* spec-sheet meta row — structural, with a real divider (not a stray line) */
  .heroc__meta {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: var(--space-m) 0 0;
    border-top: 1px solid rgba(243, 241, 228, 0.22);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    width: 100%;
    max-width: 56ch;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper-on-dark-dim);
  }

  .heroc__scroll {
    position: absolute;
    left: var(--gutter);
    bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper-on-dark-dim);
  }
  .heroc__scroll-line {
    width: 38px;
    height: 1px;
    background: linear-gradient(90deg, var(--hi-vis), transparent);
  }

  @media (max-width: 600px) {
    .heroc__scroll {
      display: none;
    }
  }
</style>
