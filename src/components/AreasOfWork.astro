---
// 6. TWO SECTORS (§12.6) — Construction & Infrastructure and Agriculture &
// Rural, as two identical balanced cards: image with a frosted title box, a
// short body, and a matching 4-icon "covers" row. Titles are sized to sit on
// one line so the two frosted boxes are the same size.
import { Image } from 'astro:assets';
import LineIcon from './LineIcon.astro';
import constructionFlagship from '../assets/images/construction-flagship.jpg';
import agriculturePaddock from '../assets/images/agriculture-paddock.jpg';

const sectorCards = [
  {
    id: 'construction',
    img: constructionFlagship,
    alt: 'A tower crane and steel frame against a clear blue sky',
    eyebrow: 'On site',
    title: 'Construction & Infrastructure',
    body: [
      'From small projects through to major developments valued at over $1 billion, I’ve worked across construction and infrastructure projects in Ireland and Australia.',
      'I understand the realities of construction and provide practical Health, Safety and Environmental advice that helps keep people safe, businesses compliant and projects moving.',
    ],
    covers: [
      { icon: 'hospital', label: 'Healthcare' },
      { icon: 'train', label: 'Rail & transport' },
      { icon: 'commercial', label: 'Commercial' },
      { icon: 'factory', label: 'Industrial' },
    ],
  },
  {
    id: 'agriculture',
    img: agriculturePaddock,
    alt: 'An Australian farm paddock in golden-hour light',
    eyebrow: 'On the land',
    title: 'Agriculture & Rural',
    body: [
      'Growing up on a farm in Ireland gave me a practical understanding of rural businesses and the challenges they face.',
      'I believe HSE should be practical, straightforward and fit around the way farms and rural businesses operate, not create unnecessary paperwork.',
    ],
    covers: [
      { icon: 'tractor', label: 'Machinery' },
      { icon: 'sprout', label: 'Cropping' },
      { icon: 'barn', label: 'Livestock' },
      { icon: 'droplet', label: 'Chemicals' },
    ],
  },
];
---

<section class="section" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <p class="section-index">Industries we support</p>
    <h2 id="areas-h" class="areas-title" data-split>Two sectors, one practical approach</h2>
    <p class="lede" data-reveal="up">
      Construction and agriculture may be different industries, but they have one thing in
      common: they need practical Health, Safety and Environmental advice that works in the real
      world.
    </p>
    <p class="lede" data-reveal="up">
      Greenline HSE provides practical HSE support that’s tailored to the way each industry
      actually works.
    </p>

    <div class="areas-grid">
      {
        sectorCards.map((s) => (
          <article class="sector" id={s.id} data-reveal="up">
            <figure class="sector__media">
              <Image
                src={s.img}
                alt={s.alt}
                class="sector__img"
                widths={[480, 800]}
                sizes="(max-width: 760px) 100vw, 50vw"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="sector__panel">
                <span class="sector__eyebrow">{s.eyebrow}</span>
                <h3 class="sector__title">{s.title}</h3>
              </figcaption>
            </figure>
            <div class="sector__body">
              {s.body.map((para) => <p>{para}</p>)}
            </div>
            <ul class="sector__covers">
              {s.covers.map((c) => (
                <li>
                  <LineIcon name={c.icon} />
                  <span>{c.label}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .areas-title {
    font-size: var(--step-3);
    max-width: 20ch;
    margin-bottom: var(--space-m);
  }
  .lede + .lede {
    margin-top: var(--space-s);
  }

  .areas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
  .sector {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    scroll-margin-top: 6rem;
  }
  .sector__media {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .sector__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  /* identical frosted title box on each image */
  .sector__panel {
    position: absolute;
    left: clamp(1rem, 2.5vw, 1.5rem);
    right: clamp(1rem, 2.5vw, 1.5rem);
    bottom: clamp(1rem, 2.5vw, 1.5rem);
    padding: clamp(0.9rem, 1.6vw, 1.25rem) clamp(1.1rem, 2vw, 1.5rem);
    background: rgba(247, 244, 234, 0.6);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    border: 1px solid rgba(252, 250, 243, 0.55);
    border-radius: var(--radius);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sector__panel {
      background: rgba(247, 244, 234, 0.95);
    }
  }
  .sector__eyebrow {
    display: block;
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--field-green);
  }
  /* sized to keep the longest title on one line, so both boxes match */
  .sector__title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.85rem + 1vw, 1.65rem);
    line-height: 1.1;
    color: var(--field-green);
    margin: 0;
    white-space: nowrap;
  }
  .sector__body {
    color: var(--bitumen);
    max-width: 48ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  /* the line-icon "covers" row — matching count, aligned at the card foot */
  .sector__covers {
    list-style: none;
    padding: var(--space-s) 0 0;
    margin: auto 0 0;
    border-top: 1px solid var(--sage);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-s);
  }
  .sector__covers li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }
  .sector__covers :global(.line-icon) {
    width: 34px;
    height: 34px;
  }
  .sector__covers span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bitumen);
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .areas-grid {
      grid-template-columns: 1fr;
    }
    /* stacked: full width, so let long titles wrap if they must */
    .sector__title {
      white-space: normal;
    }
  }
</style>
