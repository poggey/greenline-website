---
// 6. TWO SECTORS (§12.6) — Construction & Infrastructure and Agriculture &
// Rural, as two identical, balanced cards: same image, same eyebrow chip, the
// title below, and a matching 4-icon "covers" row (the line-icon set, back).
import { Image } from 'astro:assets';
import LineIcon from './LineIcon.astro';
import constructionFlagship from '../assets/images/construction-flagship.jpg';
import agriculturePaddock from '../assets/images/agriculture-paddock.jpg';

const sectorCards = [
  {
    id: 'construction',
    img: constructionFlagship,
    alt: 'A tower crane and steel frame against a clear blue sky',
    eyebrow: 'On site',
    title: 'Construction & Infrastructure',
    body: 'Support through every phase of delivery — from planning and enabling works to handover — managing the risks that matter most: falls from height, and plant and traffic.',
    covers: [
      { icon: 'hospital', label: 'Healthcare' },
      { icon: 'train', label: 'Rail & transport' },
      { icon: 'commercial', label: 'Commercial' },
      { icon: 'factory', label: 'Industrial' },
    ],
  },
  {
    id: 'agriculture',
    img: agriculturePaddock,
    alt: 'An Australian farm paddock in golden-hour light',
    eyebrow: 'On the land',
    title: 'Agriculture & Rural',
    body: 'HSE that fits how rural work runs. Agriculture carries the highest fatality rate of any Australian industry, so for operations that run lean and far from help, the support has to be real.',
    covers: [
      { icon: 'tractor', label: 'Machinery' },
      { icon: 'sprout', label: 'Cropping' },
      { icon: 'barn', label: 'Livestock' },
      { icon: 'droplet', label: 'Chemicals' },
    ],
  },
];
---

<section class="section" id="areas" aria-labelledby="areas-h">
  <div class="wrap">
    <p class="section-index">Where we work</p>
    <h2 id="areas-h" class="areas-title" data-split>Two sectors, one practical approach</h2>
    <p class="lede" data-reveal="up">
      Greenline HSE works across two sectors — construction &amp; infrastructure, and agriculture
      &amp; rural. Each gets the same senior, fit-for-purpose support, tailored to how the work is
      actually done.
    </p>

    <div class="areas-grid">
      {
        sectorCards.map((s) => (
          <article class="sector" id={s.id} data-reveal="up">
            <figure class="sector__media">
              <Image
                src={s.img}
                alt={s.alt}
                class="sector__img"
                widths={[480, 800]}
                sizes="(max-width: 760px) 100vw, 50vw"
                loading="lazy"
                decoding="async"
              />
              <span class="sector__chip">{s.eyebrow}</span>
            </figure>
            <h3 class="sector__title">{s.title}</h3>
            <p class="sector__body">{s.body}</p>
            <ul class="sector__covers">
              {s.covers.map((c) => (
                <li>
                  <LineIcon name={c.icon} />
                  <span>{c.label}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .areas-title {
    font-size: var(--step-3);
    max-width: 20ch;
    margin-bottom: var(--space-m);
  }

  .areas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
  .sector {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    scroll-margin-top: 6rem;
  }
  .sector__media {
    position: relative;
    margin: 0 0 var(--space-xs);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .sector__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  /* identical small frosted eyebrow chip on each image */
  .sector__chip {
    position: absolute;
    left: clamp(0.9rem, 2vw, 1.25rem);
    bottom: clamp(0.9rem, 2vw, 1.25rem);
    padding: 0.5rem 0.9rem;
    background: rgba(247, 244, 234, 0.6);
    backdrop-filter: blur(12px) saturate(120%);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    border: 1px solid rgba(252, 250, 243, 0.55);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--field-green);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sector__chip {
      background: rgba(247, 244, 234, 0.95);
    }
  }
  .sector__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--field-green);
    margin: 0;
  }
  .sector__body {
    color: var(--bitumen);
    max-width: 48ch;
  }
  /* the line-icon "covers" row — matching count, so both cards balance */
  .sector__covers {
    list-style: none;
    padding: var(--space-s) 0 0;
    margin: auto 0 0;
    border-top: 1px solid var(--sage);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-s);
  }
  .sector__covers li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }
  .sector__covers :global(.line-icon) {
    width: 34px;
    height: 34px;
  }
  .sector__covers span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bitumen);
    line-height: 1.3;
  }

  @media (max-width: 760px) {
    .areas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
