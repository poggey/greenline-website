---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ThroughLine from '../components/ThroughLine.astro';
import Hero from '../components/Hero.astro';
import SafetyReality from '../components/SafetyReality.astro';
import MeetGreenline from '../components/MeetGreenline.astro';
import Services from '../components/Services.astro';
import AreasOfWork from '../components/AreasOfWork.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <ThroughLine />
  <main id="main">
    <Hero />
    <MeetGreenline />
    <SafetyReality />
    <Services />
    <AreasOfWork />
    <HowWeWork />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/motion.js';
</script>
