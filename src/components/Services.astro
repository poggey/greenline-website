---
// 5. WHAT WE DO (§12.5) — the ten core services as line-icon cards.
// Pinned horizontal scroll (§11.4): the list becomes a journey along the line.
// Copy verbatim from Part I §5.
import LineIcon from './LineIcon.astro';

// Bodies are kept to a similar, short length so every card reads neatly at
// the same fixed height (see .service-card height in the styles below).
const services = [
  {
    icon: 'system',
    title: 'Health & Safety Management Systems',
    body: 'Practical systems that support compliance — and actually get used.',
  },
  {
    icon: 'risk',
    title: 'Risk Assessments',
    body: 'Identifying and managing workplace hazards through clear, usable processes.',
  },
  {
    icon: 'sop',
    title: 'Standard Operating Procedures (SOPs)',
    body: 'Easy-to-follow procedures for routine and high-risk tasks, in plain English.',
  },
  {
    icon: 'audit',
    title: 'Site Audits & Inspections',
    body: 'Independent eyes on site to verify compliance and catch issues early.',
  },
  {
    icon: 'contractor',
    title: 'Contractor Management',
    body: 'Prequalification, onboarding and ongoing management of subcontractors.',
  },
  {
    icon: 'investigation',
    title: 'Incident Investigations',
    body: 'Genuine root cause, with corrective actions and lessons that stick.',
  },
  {
    icon: 'compliance',
    title: 'Compliance Reviews',
    body: 'Measuring your operation against legislation, standards and expectations.',
  },
  {
    icon: 'training',
    title: 'Training & Inductions',
    body: 'Inductions, toolbox topics and engagement that land with the crew.',
  },
  {
    icon: 'emergency',
    title: 'Emergency Planning',
    body: 'Response arrangements you can actually execute under pressure.',
  },
  {
    icon: 'leadership',
    title: 'Leadership & Safety Culture',
    body: 'Building genuine safety cultures through leadership and engagement.',
  },
  {
    icon: 'psychosocial',
    title: 'Psychosocial Risk Management',
    body: 'Identifying and managing psychosocial hazards for healthier workplaces.',
  },
  {
    icon: 'environment',
    title: 'Environmental Management',
    body: 'Environmental compliance, risk and sustainable solutions for your operations.',
  },
];
---

<section class="services" id="services" aria-labelledby="services-h" data-services>
  <div class="wrap services__head">
    <p class="section-index">Our services</p>
    <h2 id="services-h" class="services-title" data-split>What we do</h2>
    <p class="lede" data-reveal="up">
      Greenline HSE provides practical Health, Safety and Environmental support tailored to the
      needs of each business — the full breadth of what a HSE function needs to cover.
    </p>
    <div class="services__controls" data-services-controls>
      <button class="services__arrow" type="button" data-services-prev aria-label="Previous services">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <button class="services__arrow" type="button" data-services-next aria-label="Next services">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Pinned horizontal track (§11.4). Falls back to a wrapping grid when
       motion is off or on narrow screens — handled in CSS + motion.js. -->
  <div class="services-track-outer" data-track-outer>
    <ul class="services-track" data-track>
      {
        services.map((s) => (
          <li class="service-card">
            <LineIcon name={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ul>
  </div>

</section>

<style>
  /* The section fills the viewport and centres its content, so when it pins
     the kicker + heading + lede stay on screen WITH the scrolling cards. */
  .services {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-l);
    padding-block: var(--space-l);
  }
  .services__head {
    flex: 0 0 auto;
  }
  .services-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }
  .services__head .lede {
    margin-bottom: 0;
  }
  /* Prev / next arrows — the navigation affordance that replaces the numbered
     cards. They drive the horizontal track (see motion.js initServicesArrows). */
  .services__controls {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--space-m);
  }
  .services__arrow {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--hairline);
    border-radius: 50%;
    background: transparent;
    color: var(--field-green);
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out), background 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }
  .services__arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .services__arrow:hover {
    border-color: var(--hi-vis);
    background: var(--hi-vis);
    color: var(--bitumen);
  }
  .services__arrow:focus-visible {
    outline: 2px solid var(--hi-vis);
    outline-offset: 2px;
  }

  .services-track-outer {
    flex: 0 0 auto;
    overflow: hidden;
  }
  .services-track {
    list-style: none;
    padding: 0 var(--gutter);
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 320px);
    gap: var(--space-m);
  }
  /* When motion is off / no JS, allow normal horizontal overflow scroll.
     scroll-padding keeps a gutter on the left (and snap respects it); the
     track's own right padding provides the gutter at the far right. */
  .services-track-outer:not([data-pinned]) {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-s);
  }
  .services-track-outer:not([data-pinned]) .service-card {
    scroll-snap-align: start;
  }
  .services-track-outer:not([data-pinned]) .service-card:last-child {
    /* guarantees a trailing gutter is reachable at the end of the scroll */
    scroll-snap-align: end;
  }

  .service-card {
    background: var(--cloud);
    border: var(--hairline);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* sized to fit alongside the heading within one viewport */
    height: clamp(220px, 38vh, 320px);
    position: relative;
  }
  .service-card h3 {
    font-size: var(--step-1);
    margin-top: auto;
  }
  .service-card p {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--bitumen);
  }

  /* On narrow screens the section is a normal scroll-snap row, not pinned */
  @media (max-width: 900px) {
    .services {
      min-height: 0;
      justify-content: flex-start;
      padding-block: var(--space-xl);
    }
    .service-card {
      /* fixed (not auto) so every card matches in the mobile scroll row too */
      height: 260px;
    }
  }
</style>
