---
// HERO (plain variant, for /alt) — the word-swap headline on a flat Limewash
// field, WITHOUT the dawn-gradient sky or the drawn horizon line. For comparing
// against the gradient+line hero on `/`.
---

<section class="hp" id="top" data-hero>
  <div class="wrap hp__content">
    <p class="hp__eyebrow">Greenline HSE</p>
    <h1 class="hp__headline">
      Practical
      <span class="hp__swap-wrap"
        ><span
          class="hp__swap"
          data-word-swap
          data-words='["safety","risk","compliance","culture"]'
          >safety</span
        ></span
      ><br />that works on the ground.
    </h1>
    <p class="hp__lede">
      Senior HSE expertise for Australian construction, infrastructure and rural operations,
      delivered direct.
    </p>
    <a class="btn hp__cta" href="#contact" data-magnetic
      >Start a conversation <span class="btn__arrow" aria-hidden="true">→</span></a
    >
  </div>
</section>

<style>
  .hp {
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: var(--limewash);
    padding-top: 5.5rem;
  }
  .hp__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .hp__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--field-green);
    margin: 0;
  }
  .hp__headline {
    font-family: var(--font-display);
    font-weight: 380;
    font-size: var(--step-hero);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--field-green);
    max-width: 18ch;
    margin: 0;
  }
  .hp__swap-wrap {
    display: inline-block;
  }
  .hp__swap {
    display: inline-block;
    font-style: italic;
    color: var(--field-green);
    border-bottom: 0.08em solid var(--hi-vis);
    padding: 0 0.04em 0.04em;
  }
  .hp__lede {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--bitumen);
  }
  .hp__cta {
    align-self: flex-start;
  }
</style>
