---
// 4. MEET GREENLINE (§12.4) — credibility first: a mono spec-sheet ribbon
// of credentials, then the Mayo-farm story and the boutique difference.
// No headshot (low-profile launch).
import { Image } from 'astro:assets';
import mayoFarmland from '../assets/images/meet-mayo-farmland.jpg';

const ribbon = [
  {
    key: 'EXPERIENCE',
    lines: [
      '20+ years · Ireland & Australia',
      'Construction · Infrastructure · Health · Industrial · Agriculture',
    ],
  },
  {
    key: 'EDUCATION',
    lines: [
      'BSc (Hons) Health & Safety Systems',
      'Cert IV Environmental Management & Sustainability',
      'Lead Auditor & various HSE qualifications',
    ],
  },
];

---

<section class="section band-sage" id="meet" aria-labelledby="meet-h">
  <div class="wrap">
    <p class="section-index">Who we are</p>
    <h2 id="meet-h" class="meet-title" data-split>Meet the Founder of Greenline HSE</h2>

    <div class="meet-grid">
      <div class="meet-story" data-reveal="up">
        <p class="meet-lead">
          Greenline runs on one belief: <strong
            >HSE advice is worthless unless it fits the way people actually work.</strong
          >
        </p>
        <p>
          Twenty-plus years across construction, infrastructure, healthcare and rural work in Ireland
          and Australia back that up. We give businesses what big consultancies often can’t: senior,
          straightforward HSE support, delivered by the person you actually talk to.
        </p>
        <p>Get the trust and the operations right, and compliance looks after itself.</p>
      </div>

      <!-- Place, not portrait (§4 VISUAL) — a sunlit image, no face -->
      <figure class="meet-visual" data-reveal="up">
        <Image
          src={mayoFarmland}
          alt="Sunlit green farmland divided by dry-stone walls under an open blue sky"
          class="meet-image"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          “From a farm in Mayo to construction sites across Australia, the same belief: keep it
          practical, keep it human.”
        </figcaption>
      </figure>
    </div>

    <!-- Quiet supporting credentials strip (the firm's track record) -->
    <p class="ribbon-kicker">The experience behind the firm</p>
    <dl class="ribbon" data-reveal="up" aria-label="Credentials">
      {
        ribbon.map((row) => (
          <div class="ribbon__row">
            <dt>{row.key}</dt>
            <dd>{row.lines.map((line) => <span>{line}</span>)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .meet-title {
    font-size: var(--step-3);
    max-width: 20ch;
    margin-bottom: var(--space-l);
  }

  /* Quiet supporting credentials strip — sits below the story, low-key */
  .ribbon-kicker {
    margin: var(--space-xl) 0 var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage);
  }
  .ribbon {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
    margin: 0;
  }
  .ribbon__row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ribbon dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--sage);
  }
  .ribbon dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--bitumen);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .meet-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-l);
    /* stretch so the image fills the column and its caption lines up with
       the bottom of the text on the left */
    align-items: stretch;
  }
  .meet-story {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: var(--measure);
  }
  .meet-lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--field-green);
    letter-spacing: -0.01em;
  }
  .meet-lead strong {
    font-weight: 500;
  }
  .meet-visual {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .meet-image {
    width: 100%;
    /* basis 0 so the image fills the height set by the text column,
       rather than its (large) intrinsic height driving the row taller */
    flex: 1 1 0;
    min-height: 0;
    display: block;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .meet-visual figcaption {
    margin-top: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--field-green);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .meet-grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    /* stacked: no stretch to fill, so give the image a natural ratio */
    .meet-image {
      flex: none;
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 600px) {
    .ribbon {
      grid-template-columns: 1fr;
    }
  }
</style>
