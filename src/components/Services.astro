---
// 5. HOW CAN WE HELP (§12.5) — the services as line-icon cards.
// Pinned horizontal scroll (§11.4): the list becomes a journey along the line.
import LineIcon from './LineIcon.astro';

// Each card's body is one or two short paragraphs; the track's single grid row
// stretches every card to the tallest one, so they read neatly side by side.
const services = [
  {
    icon: 'sop',
    title: 'Get your safety documents sorted',
    body: [
      'Need safety plans, SWMS, SOPs, procedures, risk assessments or emergency plans?',
      'We’ll prepare practical documents that are easy to understand and actually get used.',
    ],
  },
  {
    icon: 'compliance',
    title: 'Stay compliant',
    body: [
      'Need to meet client requirements or understand what the legislation expects?',
      'We’ll help you keep your business compliant without the jargon.',
    ],
  },
  {
    icon: 'audit',
    title: 'Site visits',
    body: [
      'We’ll visit your workplace, identify practical improvements and provide straightforward advice to help keep your people safe and your business compliant.',
    ],
  },
  {
    icon: 'training',
    title: 'Training',
    body: [
      'Once your documents and systems are in place, we’ll help your team understand how to use them with confidence.',
    ],
  },
  {
    icon: 'investigation',
    title: 'Incident support',
    body: [
      'If something goes wrong, we’ll help investigate what happened, identify the cause and recommend practical improvements to help prevent it happening again.',
    ],
  },
  {
    icon: 'environment',
    title: 'Environmental support',
    body: [
      'Need help with environmental requirements, erosion and sediment controls, waste management or environmental documentation?',
      'We’ll provide practical advice to help you meet your environmental obligations.',
    ],
  },
  {
    icon: 'advice',
    title: 'Ongoing advice',
    body: [
      'Sometimes you just need someone to call.',
      'Whether it’s a quick phone call, help with a project or advice on a health, safety or environmental issue, we’re here when you need us.',
    ],
  },
];
---

<section class="services band-sage" id="services" aria-labelledby="services-h" data-services>
  <div class="wrap services__head">
    <p class="section-index">Our services</p>
    <h2 id="services-h" class="services-title" data-split>How can we help?</h2>
    <p class="lede" data-reveal="up">
      Whether you’re starting from scratch or need some extra HSE support, we provide practical
      Health, Safety and Environmental (HSE) advice that’s easy to understand and designed for
      real workplaces.
    </p>
    <div class="services__controls" data-services-controls>
      <button class="services__arrow" type="button" data-services-prev aria-label="Previous services">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <button class="services__arrow" type="button" data-services-next aria-label="Next services">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Pinned horizontal track (§11.4). Falls back to a wrapping grid when
       motion is off or on narrow screens — handled in CSS + motion.js. -->
  <div class="services-track-outer" data-track-outer>
    <ul class="services-track" data-track>
      {
        services.map((s) => (
          <li class="service-card">
            <LineIcon name={s.icon} />
            <h3>{s.title}</h3>
            {s.body.map((para) => <p>{para}</p>)}
          </li>
        ))
      }
    </ul>
  </div>

</section>

<style>
  /* The section fills the viewport and centres its content, so when it pins
     the kicker + heading + lede stay on screen WITH the scrolling cards. */
  .services {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-l);
    padding-block: var(--space-l);
  }
  .services__head {
    flex: 0 0 auto;
  }
  .services-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }
  .services__head .lede {
    margin-bottom: 0;
  }
  /* Prev / next arrows — the navigation affordance that replaces the numbered
     cards. They drive the horizontal track (see motion.js initServicesArrows). */
  .services__controls {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--space-m);
  }
  .services__arrow {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--hairline);
    border-radius: 50%;
    background: transparent;
    color: var(--field-green);
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out), background 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }
  .services__arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .services__arrow:hover {
    border-color: var(--hi-vis);
    background: var(--hi-vis);
    color: var(--bitumen);
  }
  .services__arrow:focus-visible {
    outline: 2px solid var(--hi-vis);
    outline-offset: 2px;
  }

  .services-track-outer {
    flex: 0 0 auto;
    overflow: hidden;
  }
  .services-track {
    list-style: none;
    padding: 0 var(--gutter);
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(270px, 400px);
    gap: var(--space-m);
  }
  /* When motion is off / no JS, allow normal horizontal overflow scroll.
     scroll-padding keeps a gutter on the left (and snap respects it); the
     track's own right padding provides the gutter at the far right. */
  .services-track-outer:not([data-pinned]) {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-s);
  }
  .services-track-outer:not([data-pinned]) .service-card {
    scroll-snap-align: start;
  }
  .services-track-outer:not([data-pinned]) .service-card:last-child {
    /* guarantees a trailing gutter is reachable at the end of the scroll */
    scroll-snap-align: end;
  }

  .service-card {
    background: var(--cloud);
    border: var(--hairline);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* a floor so short cards keep their shape; the row stretches all cards
       to the tallest so the longer copy never overflows */
    min-height: clamp(240px, 34vh, 320px);
    position: relative;
  }
  .service-card h3 {
    font-size: var(--step-1);
    margin-top: auto;
  }
  .service-card p {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--bitumen);
  }

  /* Short desktop screens: the pinned section must fit heading, intro and the
     cards in one viewport below the fixed header, so tighten its spacing. */
  @media (min-width: 901px) and (max-height: 860px) {
    .services {
      gap: var(--space-m);
      padding-block: 5.5rem var(--space-s);
    }
    .services-title {
      margin-bottom: var(--space-s);
    }
    .services__head .lede {
      font-size: var(--step-0);
    }
    .services__controls {
      margin-top: var(--space-s);
    }
    .service-card {
      gap: 0.4rem;
      padding: 1.25rem 1.4rem;
    }
    .service-card :global(.line-icon) {
      width: 40px;
      height: 40px;
    }
  }

  /* On narrow screens the section is a normal scroll-snap row, not pinned */
  @media (max-width: 900px) {
    .services {
      min-height: 0;
      justify-content: flex-start;
      padding-block: var(--space-xl);
    }
  }
</style>
