---
// 2. THE SAFETY REALITY (§12.2) — the one deliberately dark, high-contrast
// section (§2 / #DATA). The stats stay type-led; a bright, hopeful, anonymous
// site image sits beside the intro to humanise the section (not over the data).
import { Image } from 'astro:assets';
import safetyReality from '../assets/images/safety-reality.jpg';
import StatBand from './StatBand.astro';
---

<section class="section section--grid" id="safety-reality" aria-labelledby="safety-reality-h">
  <div class="wrap safety-intro">
    <div class="safety-intro__text">
      <p class="section-index">The reality</p>
      <h2 id="safety-reality-h" class="section-title" data-split>
        The state of health &amp; safety in Australia
      </h2>
      <p class="lede" data-reveal="up">
        The picture most safety documents skip past. Construction and agriculture sit among the
        industries carrying the heaviest toll — and the numbers are the reason this work matters.
      </p>
    </div>
    <Image
      src={safetyReality}
      alt="A lone hi-vis worker walking away across a sunlit early-morning construction site"
      class="safety-image"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- The dark moment — full-bleed Bitumen data band (#DATA). The numerals carry
       the figures; their labels are the brief explanation. -->
  <StatBand />

  <div class="wrap">
    <p class="safety-source">Source: Safe Work Australia, Key Work Health &amp; Safety Statistics.</p>
  </div>
</section>

<style>
  .safety-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-l);
    align-items: center;
  }
  .section-title {
    font-size: var(--step-3);
    max-width: 18ch;
    margin-bottom: var(--space-m);
  }
  .safety-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (max-width: 760px) {
    .safety-intro {
      grid-template-columns: 1fr;
    }
  }
  .safety-source {
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--sage);
  }
</style>
