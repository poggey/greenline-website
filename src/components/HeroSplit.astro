---
// ALTERNATE HERO (experiment) — a split editorial layout: clean text on the
// left (light), a deep Field-Green brand panel on the right carrying an
// oversized logo-mark watermark, the signature Hi-Vis line that draws on load,
// and the tagline. Same green palette; a confident, architectural alternative
// to the gradient-horizon hero on `/`.
import LogoMark from './LogoMark.astro';
---

<section class="herob" id="top" data-hero>
  <div class="herob__text">
    <p class="eyebrow" data-reveal="up">Greenline HSE</p>
    <h1 class="herob__headline" data-split>Practical safety that works on the ground</h1>
    <p class="herob__lede lede" data-reveal="up">
      Practical Health, Safety &amp; Environmental expertise for Australian construction,
      infrastructure and rural operations. Senior advice, delivered direct.
    </p>
    <div class="herob__actions" data-reveal="up">
      <a class="btn" href="#contact" data-magnetic
        >Start a conversation <span class="btn__arrow" aria-hidden="true">→</span></a
      >
    </div>
  </div>

  <aside class="herob__panel">
    <span class="herob__mark" data-reveal aria-hidden="true"><LogoMark /></span>
    <svg class="herob__line" viewBox="0 0 600 2" preserveAspectRatio="none" aria-hidden="true">
      <line data-hero-path x1="0" y1="1" x2="600" y2="1" stroke-width="2"></line>
    </svg>
    <p class="herob__tag">Practical Solutions. Strong Relationships. Better Outcomes.</p>
  </aside>

  <a class="herob__scroll" href="#meet" aria-label="Scroll to meet Greenline">
    <span>Scroll</span>
    <span class="herob__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .herob {
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    position: relative;
  }

  /* Left — light text panel */
  .herob__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-m);
    background: var(--limewash);
    padding: 7rem var(--gutter) var(--space-xl);
  }
  .herob__headline {
    font-size: var(--step-hero);
    color: var(--field-green);
    max-width: 13ch;
    margin: 0.25rem 0 0.5rem;
  }
  .herob__lede {
    max-width: 42ch;
  }
  .herob__actions {
    margin-top: var(--space-s);
  }

  /* Right — deep green brand panel */
  .herob__panel {
    position: relative;
    overflow: hidden;
    background: var(--field-green);
    color: var(--paper-on-dark);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-l);
  }
  /* oversized mark, bleeding off the corner as a quiet watermark */
  .herob__mark {
    position: absolute;
    right: -10%;
    top: 8%;
    width: 78%;
    color: var(--paper-on-dark);
    opacity: 0.12;
  }
  /* signature Hi-Vis line draws across the panel on load */
  .herob__line {
    position: absolute;
    left: var(--space-l);
    right: var(--space-l);
    top: 46%;
    height: 2px;
    width: auto;
    overflow: visible;
  }
  .herob__line line {
    stroke: var(--hi-vis);
  }
  .herob__tag {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-on-dark);
    max-width: 24ch;
    line-height: 1.5;
  }

  .herob__scroll {
    position: absolute;
    left: calc(var(--gutter));
    bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
  }
  .herob__scroll-line {
    width: 38px;
    height: 1px;
    background: linear-gradient(90deg, var(--sage), transparent);
  }

  @media (max-width: 860px) {
    .herob {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .herob__text {
      padding-top: 7rem;
      padding-bottom: var(--space-l);
      min-height: 78svh;
      justify-content: center;
    }
    .herob__panel {
      min-height: 40svh;
      justify-content: flex-end;
    }
    .herob__mark {
      width: 56%;
      top: auto;
      bottom: -8%;
    }
    .herob__scroll {
      display: none;
    }
  }
</style>
