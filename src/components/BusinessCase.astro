---
// 7. THE BUSINESS CASE (§12.7) — safety as advantage; stat typography, no
// image (§7 DESIGN note). Hero numerals in Field Green on Limewash, tied by a
// thin Hi-Vis line. Copy verbatim from Part I §7.
const stats = [
  { value: '$28.6B', count: 28.6, prefix: '$', suffix: 'B', decimals: 1, label: 'larger national economy' },
  { value: '185,500', count: 185500, label: 'more full-time jobs' },
  { value: '1.3%', count: 1.3, suffix: '%', decimals: 1, label: 'average wage uplift' },
];
---

<section class="section band-sage" id="business-case" aria-labelledby="business-case-h">
  <div class="wrap bc-grid">
    <div class="bc-intro">
      <p class="section-index">The bottom line</p>
      <h2 id="business-case-h" class="bc-title" data-split>Safety as a business advantage</h2>
      <p class="lede" data-reveal="up">
        Safety is sometimes framed as a cost centre. The evidence says the opposite. Eliminate
        work-related injury and illness, and the national economy would be:
      </p>
    </div>

    <!-- Editorial ledger: hero numerals threaded by the Hi-Vis line -->
    <ol
      class="bc-stats"
      data-reveal="up"
      aria-label="National impact of eliminating work-related injury and illness"
    >
      {
        stats.map((s) => (
          <li class="bc-stat">
            <span
              class="bc-stat__value"
              data-count={s.count}
              data-prefix={s.prefix ?? ''}
              data-suffix={s.suffix ?? ''}
              data-decimals={s.decimals ?? 0}
            >
              {s.value}
            </span>
            <span class="bc-stat__label">{s.label}</span>
          </li>
        ))
      }
    </ol>
  </div>

</section>

<style>
  .bc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-l);
    align-items: center;
  }
  .bc-intro {
    max-width: 42ch;
  }
  .bc-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }

  /* Editorial ledger — big numerals threaded by the Hi-Vis line (the motif) */
  .bc-stats {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--hi-vis);
  }
  .bc-stat {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--space-l);
    padding: clamp(1.25rem, 0.5rem + 2vw, 2.25rem) 0 clamp(1.25rem, 0.5rem + 2vw, 2.25rem)
      var(--space-l);
    border-bottom: 1px solid var(--sage);
  }
  .bc-stat:first-child {
    border-top: 1px solid var(--sage);
  }
  .bc-stat__value {
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.6rem, 1.4rem + 4vw, 4.75rem);
    line-height: 0.9;
    color: var(--field-green);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bc-stat__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bitumen);
    line-height: 1.4;
  }

  @media (max-width: 860px) {
    .bc-grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .bc-intro {
      max-width: var(--measure);
    }
  }
</style>
