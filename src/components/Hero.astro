---
// 1. HERO (§12.1) — light, design-led. Dawn-gradient sky with a land plane
// below, divided by the signature Hi-Vis horizon line that draws on load.
// The headline cycles one word (safety / risk / compliance / culture) via a
// smooth GSAP fade-swap; reduced motion shows the first word, static.
---

<section class="hero" id="top" data-hero>
  <!-- Dawn-sky gradient (§HERO) -->
  <div class="hero__sky" aria-hidden="true"></div>

  <!-- One clean, straight horizon: land fill below, Hi-Vis line drawn on load -->
  <svg class="hero__horizon" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="hero-land" x1="0" y1="0" x2="0" y2="1">
        <stop class="hero-land-top" offset="0"></stop>
        <stop class="hero-land-bottom" offset="1"></stop>
      </linearGradient>
    </defs>
    <path class="hero__fill" d="M0,3 H1440 V200 H0 Z"></path>
    <path data-hero-path class="hero__stroke" d="M0,3 H1440" fill="none" stroke-width="2.5"></path>
  </svg>

  <div class="wrap hero__content">
    <p class="hero__eyebrow">Greenline HSE</p>
    <h1 class="hero__headline">
      Practical
      <span class="hero__swap-wrap"
        ><span
          class="hero__swap"
          data-word-swap
          data-words='["safety","risk","compliance","culture"]'
          >safety</span
        ></span
      ><br />that works on the ground.
    </h1>
    <p class="hero__lede">
      Senior HSE expertise for Australian construction, infrastructure and rural operations —
      delivered direct.
    </p>
    <a class="btn hero__cta" href="#contact" data-magnetic
      >Start a conversation <span class="btn__arrow" aria-hidden="true">→</span></a
    >
  </div>

  <a class="hero__scroll" href="#meet" aria-label="Scroll to meet Greenline">
    <span class="hero__scroll-label">Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 6rem;
    /* reserve the lower band for the horizon + land */
    padding-bottom: 26vh;
  }
  .hero__sky {
    position: absolute;
    inset: 0;
    background: var(--hero-sky);
    z-index: -3;
  }
  .hero__horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 22%;
    z-index: -1;
    overflow: visible;
  }
  .hero__fill {
    fill: url(#hero-land);
  }
  .hero-land-top {
    stop-color: var(--hero-land-top);
  }
  .hero-land-bottom {
    stop-color: var(--hero-land-bottom);
  }
  .hero__stroke {
    stroke: var(--hi-vis);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--field-green);
    margin: 0;
  }
  .hero__headline {
    font-family: var(--font-display);
    font-weight: 380;
    font-size: var(--step-hero);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--field-green);
    max-width: 18ch;
    margin: 0;
  }
  /* cycling word — fade-swaps in place; no clip, so nothing is cut off */
  .hero__swap-wrap {
    display: inline-block;
  }
  .hero__swap {
    display: inline-block;
    font-style: italic;
    color: var(--field-green);
    border-bottom: 0.08em solid var(--hi-vis);
    padding: 0 0.04em 0.04em;
  }
  .hero__lede {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--bitumen);
  }
  .hero__cta {
    align-self: flex-start;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage);
  }
  /* text-indent offsets the trailing letter-spacing so the label's glyphs
     centre on the same axis as the line below */
  .hero__scroll-label {
    display: inline-block;
    text-indent: 0.2em;
  }
  .hero__scroll-line {
    width: 1px;
    height: 38px;
    background: linear-gradient(var(--sage), transparent);
  }

  @media (max-width: 600px) {
    .hero {
      padding-bottom: 20vh;
    }
    .hero__horizon {
      height: 16%;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>
